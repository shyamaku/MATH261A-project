head(dog_dat)
intake_d <- as.Date(dog_dat$intake_date, format="%Y-%m-%d")
outcome_d <- as.Date(dog_dat$outcome_date, format="%Y-%m-%d")
dob <- as.Date(dog_dat$dob, format="%Y-%m-%d")
